#!/usr/bin/env bash
set -uo pipefail

set_runtime_dir() {
  runtime_dir="$1"
  pidfile="${runtime_dir}/sshuttle.pid"
  metafile="${runtime_dir}/target"
  startfile="${runtime_dir}/started-at"
  linkstartfile="${runtime_dir}/link-start"
}

set_runtime_dir "/run/sshuttledeck/$UID"

die() {
  printf 'SSHuttleDeck: %s\n' "$*" >&2
  exit 1
}

valid_port() {
  [[ "$1" =~ ^[0-9]{1,5}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 ))
}

read_ssh_config() {
  local file="$1" line rest pattern included alias
  [[ -r "$file" ]] || return
  file="$(realpath -m "$file")"
  [[ -z "${seen[$file]:-}" ]] || return
  seen[$file]=1

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -n "$line" && "${line:0:1}" != "#" ]] || continue
    if [[ "$line" =~ ^[Hh][Oo][Ss][Tt][[:space:]]+(.+)$ ]]; then
      rest="${BASH_REMATCH[1]}"
      read -r -a aliases <<< "$rest"
      for alias in "${aliases[@]}"; do
        alias="${alias#\"}"
        alias="${alias%\"}"
        [[ "$alias" == *'*'* || "$alias" == *'?'* || "$alias" == '!'* ]] && continue
        [[ -n "$alias" ]] && printf '%s\n' "$alias"
      done
    elif [[ "$line" =~ ^[Ii][Nn][Cc][Ll][Uu][Dd][Ee][[:space:]]+(.+)$ ]]; then
      rest="${BASH_REMATCH[1]}"
      read -r -a patterns <<< "$rest"
      for pattern in "${patterns[@]}"; do
        pattern="${pattern#\"}"
        pattern="${pattern%\"}"
        if [[ "$pattern" == "~/"* ]]; then
          pattern="$HOME/${pattern:2}"
        elif [[ "$pattern" != /* ]]; then
          pattern="$(dirname "$file")/$pattern"
        fi
        while IFS= read -r included; do read_ssh_config "$included"; done < <(compgen -G "$pattern" || true)
      done
    fi
  done < "$file"
}

list_hosts() {
  declare -A seen=()
  read_ssh_config "$HOME/.ssh/config" | LC_ALL=C sort -u
}

link_stats() {
  local iface
  iface="$(ip route show default 2>/dev/null | awk 'NR == 1 { print $5 }')"
  [[ -n "$iface" ]] || die "No default network interface."
  awk -v iface="$iface" '$1 == iface ":" { print iface "\t" $2 "\t" $10 }' /proc/net/dev
}

public_ip() {
  command -v curl >/dev/null || die "curl is not installed."
  curl --fail --silent --show-error --max-time 5 https://ipwho.is/
}

status() {
  local pid target="" command="" started="" link_start="" elapsed=""
  local active_pidfile="$pidfile" active_metafile="$metafile" active_startfile="$startfile" active_linkstartfile="$linkstartfile"
  # Preserve control of an existing tunnel while migrating it from the former
  # user-runtime location to the hardened root-owned runtime directory.
  if [[ ! -s "$active_pidfile" && -s "/run/user/$UID/sshuttledeck/sshuttle.pid" ]]; then
    active_pidfile="/run/user/$UID/sshuttledeck/sshuttle.pid"
    active_metafile="/run/user/$UID/sshuttledeck/target"
    active_startfile="/run/user/$UID/sshuttledeck/started-at"
    active_linkstartfile="/run/user/$UID/sshuttledeck/link-start"
  fi
  [[ -s "$active_pidfile" ]] || { printf 'disconnected\n'; return; }
  read -r pid < "$active_pidfile" || true
  # The daemon is root-owned after pkexec, so a regular user gets EPERM from
  # kill -0 even while it is healthy. Its command line is still observable.
  command="$(ps -p "$pid" -o args= 2>/dev/null || true)"
  if [[ "$pid" =~ ^[0-9]+$ ]] && [[ "$command" == *sshuttle* ]] && [[ "$command" == *"--pidfile $active_pidfile"* ]]; then
    [[ -r "$active_metafile" ]] && target="$(<"$active_metafile")"
    if [[ -r "$active_startfile" ]]; then
      read -r started < "$active_startfile" || true
    fi
    if [[ ! "$started" =~ ^[0-9]+$ ]]; then
      elapsed="$(ps -p "$pid" -o etimes= 2>/dev/null | tr -d ' ' || true)"
      [[ "$elapsed" =~ ^[0-9]+$ ]] && started="$(( $(date +%s) - elapsed ))"
    fi
    [[ -r "$active_linkstartfile" ]] && link_start="$(<"$active_linkstartfile")"
    printf 'connected\t%s\t%s\t%s\n' "$target" "$started" "$link_start"
  else
    printf 'disconnected\n'
  fi
}

valid_host() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ || "$1" =~ ^[0-9A-Fa-f:]+$ ]]
}

valid_user() {
  [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_.-]{0,31}$ ]]
}

safe_identity() {
  local candidate="$1" canonical mode
  [[ "$candidate" == "~/"* ]] && candidate="$HOME/${candidate:2}"
  canonical="$(realpath -e "$candidate" 2>/dev/null)" || return
  [[ "$canonical" == "$HOME/.ssh/"* && -f "$canonical" && ! -L "$canonical" ]] || return
  [[ "$(stat -c %u "$canonical")" == "$UID" ]] || return
  mode="$(stat -c %a "$canonical")"
  (( (8#$mode & 077) == 0 )) || return
  printf '%s\n' "$canonical"
}

resolve() {
  local target="$1" requested_port="$2" output key value host="" user="" port="" identity="" candidate
  [[ -n "$target" && "$target" != -* && ! "$target" =~ [[:space:]] ]] || die "Invalid SSH host or alias."
  [[ -z "$requested_port" ]] || valid_port "$requested_port" || die "SSH port must be between 1 and 65535."
  output="$(ssh -G -- "$target" 2>/dev/null)" || die "Could not resolve SSH host '$target'."
  while read -r key value; do
    case "$key" in
      hostname) host="$value" ;;
      user) user="$value" ;;
      port) port="$value" ;;
      identityfile)
        candidate="$(safe_identity "$value" || true)"
        [[ -z "$identity" && -n "$candidate" ]] && identity="$candidate"
        ;;
    esac
  done <<< "$output"
  [[ -n "$requested_port" ]] && port="$requested_port"
  valid_host "$host" || die "Resolved SSH host is unsafe or unsupported."
  valid_user "$user" || die "Resolved SSH user is unsafe or unsupported."
  valid_port "$port" || die "Resolved SSH port is invalid."
  printf '%s\t%s\t%s\t%s\n' "$host" "$user" "$port" "${identity:--}"
}

case "${1:-}" in
  hosts) list_hosts ;;
  status) status ;;
  resolve)
    [[ $# -eq 3 ]] || die "Invalid SSH resolution request."
    resolve "$2" "$3"
    ;;
  link-stats) link_stats ;;
  public-ip) public_ip ;;
  *) die "Usage: sshuttledeck {hosts|link-stats|public-ip|resolve|status}" ;;
esac
