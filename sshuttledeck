#!/usr/bin/env bash
set -uo pipefail

set_runtime_dir() {
  runtime_dir="$1"
  pidfile="${runtime_dir}/sshuttle.pid"
  metafile="${runtime_dir}/target"
}

set_runtime_dir "${XDG_RUNTIME_DIR:-/run/user/$UID}/sshuttledeck"
ssh_command=""

die() {
  printf 'SSHuttleDeck: %s\n' "$*" >&2
  exit 1
}

valid_port() {
  [[ "$1" =~ ^[0-9]{1,5}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 ))
}

remote_for() {
  local target="$1" port="$2" user_prefix="" host
  [[ -n "$port" ]] || { printf '%s\n' "$target"; return; }

  host="$target"
  if [[ "$target" == *@* ]]; then
    user_prefix="${target%@*}@"
    host="${target##*@}"
  fi

  if [[ "$host" == \[*\] ]]; then
    printf '%s%s:%s\n' "$user_prefix" "$host" "$port"
  elif [[ "$host" == *:* ]]; then
    printf '%s[%s]:%s\n' "$user_prefix" "$host" "$port"
  else
    printf '%s%s:%s\n' "$user_prefix" "$host" "$port"
  fi
}

read_ssh_config() {
  local file="$1" line rest pattern included alias
  [[ -r "$file" ]] || return
  file="$(realpath -m "$file")"
  [[ -z "${seen[$file]:-}" ]] || return
  seen[$file]=1

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -n "$line" && "${line:0:1}" != "#" ]] || continue
    if [[ "$line" =~ ^[Hh][Oo][Ss][Tt][[:space:]]+(.+)$ ]]; then
      rest="${BASH_REMATCH[1]}"
      read -r -a aliases <<< "$rest"
      for alias in "${aliases[@]}"; do
        alias="${alias#\"}"
        alias="${alias%\"}"
        [[ "$alias" == *'*'* || "$alias" == *'?'* || "$alias" == '!'* ]] && continue
        [[ -n "$alias" ]] && printf '%s\n' "$alias"
      done
    elif [[ "$line" =~ ^[Ii][Nn][Cc][Ll][Uu][Dd][Ee][[:space:]]+(.+)$ ]]; then
      rest="${BASH_REMATCH[1]}"
      read -r -a patterns <<< "$rest"
      for pattern in "${patterns[@]}"; do
        pattern="${pattern#\"}"
        pattern="${pattern%\"}"
        if [[ "$pattern" == "~/"* ]]; then
          pattern="$HOME/${pattern:2}"
        elif [[ "$pattern" != /* ]]; then
          pattern="$(dirname "$file")/$pattern"
        fi
        while IFS= read -r included; do read_ssh_config "$included"; done < <(compgen -G "$pattern" || true)
      done
    fi
  done < "$file"
}

list_hosts() {
  declare -A seen=()
  read_ssh_config "$HOME/.ssh/config" | LC_ALL=C sort -u
}

link_stats() {
  local iface
  iface="$(ip route show default 2>/dev/null | awk 'NR == 1 { print $5 }')"
  [[ -n "$iface" ]] || die "No default network interface."
  awk -v iface="$iface" '$1 == iface ":" { print iface "\t" $2 "\t" $10 }' /proc/net/dev
}

public_ip() {
  command -v curl >/dev/null || die "curl is not installed."
  curl --fail --silent --show-error --max-time 5 https://ipwho.is/
}

status() {
  local pid target="" command=""
  [[ -s "$pidfile" ]] || { printf 'disconnected\n'; return; }
  read -r pid < "$pidfile" || true
  # The daemon is root-owned after pkexec, so a regular user gets EPERM from
  # kill -0 even while it is healthy. Its command line is still observable.
  command="$(ps -p "$pid" -o args= 2>/dev/null || true)"
  if [[ "$pid" =~ ^[0-9]+$ ]] && [[ "$command" == *sshuttle* ]] && [[ "$command" == *"--pidfile $pidfile"* ]]; then
    [[ -r "$metafile" ]] && target="$(<"$metafile")"
    printf 'connected\t%s\n' "$target"
  else
    rm -f "$pidfile" "$metafile" 2>/dev/null || true
    printf 'disconnected\n'
  fi
}

start() {
  local target="$1" port="$2" routes="$3" dns="$4" auto_nets="$5" remote pid
  local -a args route_args

  [[ -n "$target" && ! "$target" =~ [[:space:]] ]] || die "Enter a host, IP address, or SSH alias."
  [[ -z "$port" ]] || valid_port "$port" || die "SSH port must be between 1 and 65535."
  read -r -a route_args <<< "$routes"
  (( ${#route_args[@]} > 0 )) || die "Enter at least one route, such as 0/0."
  for route in "${route_args[@]}"; do [[ "$route" != -* ]] || die "Routes cannot be SSHuttle options."; done
  command -v sshuttle >/dev/null || die "sshuttle is not installed. Run: omarchy pkg add sshuttle"

  mkdir -p "$runtime_dir"
  remote="$(remote_for "$target" "$port")"
  args=(sshuttle --daemon --pidfile "$pidfile" --remote "$remote")
  # OpenSSH chooses its per-user config from the effective UID, not $HOME.
  # pkexec makes that UID root, so supply the requesting user's config file.
  [[ -n "$ssh_command" ]] && args+=(--ssh-cmd "$ssh_command")
  [[ "$dns" == "1" ]] && args+=(--dns)
  [[ "$auto_nets" == "1" ]] && args+=(--auto-nets)

  "${args[@]}" "${route_args[@]}"
  # sshuttle --daemon exits before the remote connection is usable. Wait for
  # its daemon PID so the panel never shows a tunnel that already died.
  for _ in {1..10}; do
    if [[ -s "$pidfile" ]]; then
      read -r pid < "$pidfile" || true
      if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        printf '%s\n' "$remote" > "$metafile"
        printf 'SSHuttleDeck connected through %s.\n' "$remote"
        return
      fi
    fi
    sleep 0.5
  done
  rm -f "$pidfile" "$metafile"
  die "SSHuttle exited before the tunnel became ready."
}

stop() {
  local pid
  [[ -s "$pidfile" ]] || { printf 'SSHuttleDeck is not connected.\n'; return; }
  read -r pid < "$pidfile" || true
  [[ "$pid" =~ ^[0-9]+$ ]] || die "The saved SSHuttle PID is invalid."
  kill -TERM "$pid" 2>/dev/null || true
  rm -f "$pidfile" "$metafile"
  printf 'SSHuttleDeck disconnected.\n'
}

pkexec_context() {
  local owner_uid="${PKEXEC_UID:-}" owner_name owner_home agent_socket="$1"
  [[ $EUID -eq 0 ]] || die "This action must be authorized through pkexec."
  [[ "$owner_uid" =~ ^[0-9]+$ ]] || die "pkexec did not provide the requesting user."
  owner_name="$(id -nu "$owner_uid" 2>/dev/null)" || die "Unknown requesting user."
  owner_home="$(getent passwd "$owner_uid" | cut -d: -f6)"
  [[ -n "$owner_home" && -d "$owner_home" ]] || die "Could not resolve the requesting user's home directory."

  set_runtime_dir "/run/user/${owner_uid}/sshuttledeck"
  mkdir -p -m 755 "$runtime_dir"
  export HOME="$owner_home" USER="$owner_name" LOGNAME="$owner_name"
  if [[ -r "$owner_home/.ssh/config" ]]; then
    ssh_command="ssh -F \"$owner_home/.ssh/config\""
    # The shell is started without SSH_AUTH_SOCK. Explicitly offer the user's
    # standard private keys rather than falling back to root's keyring.
    for identity in "$owner_home/.ssh/id_ed25519" "$owner_home/.ssh/id_rsa"; do
      [[ -r "$identity" ]] && ssh_command+=" -i \"$identity\""
    done
  fi
  # Root can access the user's agent socket, but only accept a socket owned by
  # the requesting user. This keeps key-based SSH authentication noninteractive.
  if [[ -n "$agent_socket" && -S "$agent_socket" ]] && [[ "$(stat -c %u "$agent_socket")" == "$owner_uid" ]]; then
    export SSH_AUTH_SOCK="$agent_socket"
  else
    unset SSH_AUTH_SOCK
  fi
}

root_start() {
  local agent_socket="$1"
  pkexec_context "$agent_socket"
  start "$2" "$3" "$4" "$5" "$6"
}

root_stop() {
  pkexec_context "${1:-}"
  stop
}

case "${1:-}" in
  hosts) list_hosts ;;
  status) status ;;
  start)
    [[ $# -eq 6 ]] || die "Invalid launch request."
    start "$2" "$3" "$4" "$5" "$6"
    ;;
  root-start)
    [[ $# -eq 7 ]] || die "Invalid privileged launch request."
    root_start "$2" "$3" "$4" "$5" "$6" "$7"
    ;;
  stop) stop ;;
  root-stop) root_stop "${2:-}" ;;
  link-stats) link_stats ;;
  public-ip) public_ip ;;
  *) die "Usage: sshuttledeck {hosts|link-stats|public-ip|status|start|root-start|root-stop|stop}" ;;
esac
